if(NOT DEFINED SIMULATOR OR NOT DEFINED SAVE_FILE)
 message(FATAL_ERROR "Simulator and isolated save path are required")
endif()
execute_process(COMMAND "${SIMULATOR}" --smoke-test --save-file "${SAVE_FILE}" RESULT_VARIABLE first OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT first EQUAL 0)
 message(FATAL_ERROR "Initial process failed: ${output} ${errors}")
endif()
execute_process(COMMAND "${SIMULATOR}" --resume-test --save-file "${SAVE_FILE}" RESULT_VARIABLE second OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT second EQUAL 0)
 message(FATAL_ERROR "Resume process failed: ${output} ${errors}")
endif()
message(STATUS "Separate simulator process resumed four players and 49 life")
